# Normalise everything to LF in the repository. Without this, files
# committed from Windows keep CRLF endings, and CI on Linux fails with
# "bad interpreter: /usr/bin/env: 'bash\r'".
* text=auto eol=lf

*.v      text eol=lf
*.vh     text eol=lf
*.sh     text eol=lf
*.tcl    text eol=lf
*.xdc    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
Makefile text eol=lf

# Binary assets, never touched
*.png    binary
*.jpg    binary
*.bit    binary
*.vcd    binary
